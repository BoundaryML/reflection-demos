{
  "name": "demo-7-notebook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "tsx backend/src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "pnpm run typecheck && vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.backend.json",
    "baml:generate": "node scripts/check-baml.mjs"
  },
  "dependencies": {
    "@boundaryml/baml-bridge": "0.17.1-nightly.20260823.a",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
