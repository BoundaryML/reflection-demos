{
  "name": "demo-5-schema-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BEP-066 Scenario 5 \u2014 live compiler diagnostics for user- or model-written BAML schemas",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "tsx backend/src/index.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "tsx backend/src/index.ts",
    "typecheck": "tsc -p backend/tsconfig.json && tsc -p frontend/tsconfig.json",
    "baml:generate": "node -e \"console.log('demo-5: no client generation needed \u2014 the backend boots baml_src/ directly via BamlRuntime.initializeRuntime')\""
  },
  "dependencies": {
    "@boundaryml/baml-bridge": "link:../vendor/baml/baml_language/sdks/typescript/bridge_typescript",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@lezer/highlight": "^1.2.1",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
